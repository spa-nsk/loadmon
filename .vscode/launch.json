    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}\\server_web_new\\main_web.go",
            "preLaunchTask": "go build with ldflags"
        },
        {
            "name": "sqliteadmin",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/tools/sqliteadmin",
            "cwd": "${workspaceFolder}",
            "args": [
                "-config",
                "server_web_new/conf/app2.json"
            ]
        }
    ]
}
