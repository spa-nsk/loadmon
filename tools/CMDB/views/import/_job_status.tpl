{{if eq . "succeeded"}}<span class="badge text-bg-success">выполнено</span>{{else if eq . "failed"}}<span class="badge text-bg-danger">сбой</span>{{else if eq . "running"}}<span class="badge text-bg-warning">выполняется</span>{{else if eq . "queued"}}<span class="badge text-bg-info">в очереди</span>{{else if eq . "cancelled"}}<span class="badge text-bg-secondary">отменено</span>{{else}}{{.}}{{end}}
